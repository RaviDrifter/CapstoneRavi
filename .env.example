# Leave blank to run the fully offline, evidence-template fallback.
OPENROUTER_API_KEY=
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
USE_LLM=false
LLM_TIMEOUT_SECONDS=12
EMBEDDING_MODEL=all-MiniLM-L6-v2
# tfidf is deterministic, offline and suitable for the clean-checkout evaluation gate.
# Set to chroma to enable persistent ChromaDB + sentence-transformers embeddings when installed.
RETRIEVAL_BACKEND=tfidf
CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db
DATA_DIR=./data
DOCUMENTATION_PATH=./data/documentation.json
DEVELOPMENT_TICKETS_PATH=./data/development_tickets.json
CONFIDENCE_THRESHOLD=0.10
ANSWERABILITY_THRESHOLD=0.40
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.025
LOG_LEVEL=INFO
# Kill-switch: set to false to disable all autonomous responses (POST /tickets returns 503)
PIPELINE_ENABLED=true
# API server port
PORT=8000
